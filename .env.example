# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key: only used by the browser to upload photos to signed URLs.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (server only, never NEXT_PUBLIC_). The legacy service_role key also works.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Passcode to open the app. Use something long; changing it signs out every device.
APP_PASSCODE=

# Optional: DeepL API Free key (https://www.deepl.com/pro-api, 500,000 chars/month free).
# Without it, translation falls back to the MyMemory free API (no key, ~5,000 chars/day).
DEEPL_API_KEY=
